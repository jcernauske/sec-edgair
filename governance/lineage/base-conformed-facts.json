      "namespace": "sec-edgair",
      "name": "base.conformed_facts",
      "facets": {
        "documentation": {
          "description": "Reads base.financial_facts and base.entity_mappings (for fiscal_year_end lookup). Normalizes legacy CDE-XXX IDs to BT-XXX. Filters out superseded facts (is_superseded=true), rows with NULL business_term_id, and rows with NULL fiscal_year. Applies unit filtering using PRIMARY_UNIT per business term (USD for most, USD/shares for EPS and dividends). Groups by grain (cik, business_term_id, fiscal_year, fiscal_period) and resolves concept collisions: sole_candidate when only one fact exists, primary_concept when a PRIMARY_CONCEPTS list match is found, tier_frequency_fallback otherwise. Writes to base.conformed_facts with source_fact_id lineage, competing_fact_count, and selection_reason metadata."
        },
        "sourceCode": {
          "sourceCodeLocation": "src/base/conformed_facts/build.py"
        },
        "secEdgair_transformationDetail": {
          "steps": [
            {
              "order": 0,
              "name": "legacy_id_normalization",
              "description": "Translate CDE-XXX business_term_id values to BT-XXX using LEGACY_CDE_TO_BT mapping"
            },
            {
              "order": 1,
              "name": "supersession_filtering",
              "description": "Remove rows where is_superseded = true (approximately 49.3% of source)"
            },
            {
              "order": 2,
              "name": "null_bt_filtering",
              "description": "Remove rows where business_term_id IS NULL (unmapped XBRL concepts)"
            },
            {
              "order": 3,
              "name": "null_fy_filtering",
              "description": "Remove rows where fiscal_year IS NULL"
            },
            {
              "order": 4,
              "name": "unit_filtering",
              "description": "Keep only rows matching PRIMARY_UNIT per business term (USD for most BTs, USD/shares for BT-044/BT-045/BT-046)"
            },
            {
              "order": 5,
              "name": "concept_collision_resolution",
              "description": "Group by (cik, business_term_id, fiscal_year, fiscal_period). Select winning fact: sole_candidate if only one fact, primary_concept if PRIMARY_CONCEPTS list match found, tier_frequency_fallback (lowest tier then most common concept) otherwise"
            }
          ],
          "configArtifact": "governance/conformation/concept-priority-rules.json"
        }
      }
    },
