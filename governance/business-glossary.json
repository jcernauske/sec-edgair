  "terms": [
    {
      "term_id": "BT-001",
      "term": "Central Index Key (CIK)",
      "definition": "Unique numeric identifier assigned by the SEC to every entity that files with the Commission. Used as the primary company identifier throughout the pipeline.",
      "source": "sec-edgar",
      "source_reference": "SEC EDGAR Filing Manual, Section 3.1",
      "synonyms": ["CIK", "CIK Number"],
      "related_terms": ["BT-003"],
      "category": "entity",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": "CDE-001",
      "used_in_models": ["base-entity-resolution", "base-financial-facts-model"]
    },
    {
      "term_id": "BT-002",
      "term": "Accession Number",
      "definition": "Unique identifier for each filing submitted to SEC EDGAR. Format: XXXXXXXXXX-YY-ZZZZZZ. Used to trace any data point back to its source filing.",
      "source": "sec-edgar",
      "source_reference": "SEC EDGAR Filing Manual, Section 4.2",
      "synonyms": ["Filing ID", "Accession"],
      "related_terms": ["BT-004"],
      "category": "filing",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": "CDE-002",
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-003",
      "term": "Legal Entity Name",
      "definition": "Official company name as registered with the SEC. May differ from commonly used brand names (e.g., 'MICROSOFT CORPORATION' vs 'Microsoft Corp.').",
      "source": "sec-edgar",
      "source_reference": "SEC EDGAR Company Search documentation",
      "synonyms": ["Entity Name", "Registrant Name", "Company Name"],
      "related_terms": ["BT-001", "BT-005"],
      "category": "entity",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": "CDE-003",
      "used_in_models": ["base-entity-resolution"]
    },
    {
      "term_id": "BT-004",
      "term": "SEC Filing",
      "definition": "A document submitted to and accepted by the SEC through the EDGAR system. Includes periodic reports (10-K, 10-Q), current reports (8-K), and amendments (10-K/A, 10-Q/A).",
      "source": "sec-edgar",
      "source_reference": "SEC EDGAR Filing Types documentation",
      "synonyms": ["Filing", "Report", "Submission"],
      "related_terms": ["BT-002", "BT-006", "BT-007"],
      "category": "filing",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": null,
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-005",
      "term": "Canonical Company Identity",
      "definition": "A normalized, human-approved company identity that serves as the single source of truth for 'who is this company?' across the pipeline. Resolves inconsistencies in SEC EDGAR entity names (all-caps, abbreviations, legal suffixes) to one authoritative representation.",
      "source": "project-specific",
      "source_reference": "docs/specs/base-entity-resolution.md",
      "synonyms": ["Canonical Entity", "Resolved Entity"],
      "related_terms": ["BT-001", "BT-003", "BT-008"],
      "category": "entity",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-entity-resolution"]
    },
    {
      "term_id": "BT-006",
      "term": "Filing Date",
      "definition": "Date the filing was officially submitted to and accepted by the SEC. Critical for determining the timeline of financial disclosures and for amendment tracking.",
      "source": "sec-edgar",
      "source_reference": "SEC EDGAR Filing Manual",
      "synonyms": ["Filed Date", "Submission Date"],
      "related_terms": ["BT-004", "BT-002"],
      "category": "filing",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": "CDE-004",
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-007",
      "term": "Amendment",
      "definition": "A revised SEC filing (form type ending in '/A', e.g., 10-K/A, 10-Q/A) that corrects or updates a previously submitted filing. Amendments supersede the original filing's values for the same reporting period and concept.",
      "source": "sec-edgar",
      "source_reference": "SEC EDGAR Amendment Filing documentation",
      "synonyms": ["Amended Filing", "Restatement"],
      "related_terms": ["BT-004", "BT-012"],
      "category": "filing",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": null,
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-008",
      "term": "Entity Resolution",
      "definition": "The process of mapping raw, inconsistent entity identifiers (CIK + entity name as received from SEC EDGAR) to a canonical company identity. Involves matching, confidence scoring, and human approval.",
      "source": "project-specific",
      "source_reference": "docs/specs/base-entity-resolution.md",
      "synonyms": ["Identity Resolution", "Entity Matching"],
      "related_terms": ["BT-005", "BT-001", "BT-010"],
      "category": "pipeline",
      "owner": "Data Engineering",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-entity-resolution"]
    },
    {
      "term_id": "BT-009",
      "term": "XBRL Concept",
      "definition": "A specific financial metric tag from an XBRL taxonomy (e.g., us-gaap:Revenues, us-gaap:Assets). Each concept has a standardized name, human-readable label, and formal definition from the taxonomy authority.",
      "source": "xbrl-taxonomy",
      "source_reference": "XBRL International Specification, Section 5.1",
      "synonyms": ["XBRL Tag", "Taxonomy Element", "Concept"],
      "related_terms": ["BT-011", "BT-013"],
      "category": "financial",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": null,
      "used_in_models": ["base-xbrl-tag-normalization", "base-financial-facts-model"]
    },
    {
      "term_id": "BT-010",
      "term": "Confidence Score",
      "definition": "A numeric value (0.0 to 1.0) representing the pipeline's certainty in a proposed mapping. Used in entity resolution (1.0 = exact CIK match, 0.5 = fuzzy name match) and tag normalization (1.0 = exact concept match, 0.7 = prefix match, 0.6 = pattern match, 0.0 = unmapped).",
      "source": "project-specific",
      "source_reference": "docs/specs/base-entity-resolution.md, docs/specs/base-xbrl-tag-normalization.md",
      "synonyms": ["Confidence", "Match Confidence"],
      "related_terms": ["BT-008", "BT-011", "BT-014"],
      "category": "pipeline",
      "owner": "Data Engineering",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-entity-resolution", "base-xbrl-tag-normalization"]
    },
    {
      "term_id": "BT-011",
      "term": "Tag Normalization",
      "definition": "The process of classifying ~3,285 us-gaap XBRL concepts into 25 canonical financial CDEs using a tiered matching engine (exact match, prefix/pattern match, or unmapped). Produces a reusable concept dimension for cross-company analysis.",
      "source": "project-specific",
      "source_reference": "docs/specs/base-xbrl-tag-normalization.md",
      "synonyms": ["Concept Classification", "XBRL Normalization"],
      "related_terms": ["BT-009", "BT-013", "BT-015"],
      "category": "pipeline",
      "owner": "Data Engineering",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-xbrl-tag-normalization"]
    },
    {
      "term_id": "BT-012",
      "term": "Supersession",
      "definition": "The relationship where a later SEC filing replaces an earlier filing for the same company, concept, unit, and reporting period. The original fact is marked as superseded; the amendment's value is the current truth. Both filings are preserved for audit.",
      "source": "project-specific",
      "source_reference": "docs/specs/base-financial-facts-model.md",
      "synonyms": ["Filing Supersession", "Amendment Override"],
      "related_terms": ["BT-007", "BT-004"],
      "category": "pipeline",
      "owner": "Data Engineering",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-013",
      "term": "Canonical CDE",
      "definition": "One of 25 standardized financial data elements (e.g., Revenue, Total Assets, Net Income) that serve as the common language for cross-company financial comparison. XBRL concepts map to these CDEs through the tag normalization process.",
      "source": "project-specific",
      "source_reference": "docs/specs/base-xbrl-tag-normalization.md",
      "synonyms": ["Critical Data Element", "Canonical Financial Metric"],
      "related_terms": ["BT-009", "BT-011"],
      "category": "pipeline",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": "CDE-007 through CDE-031",
      "used_in_models": ["base-xbrl-tag-normalization", "base-financial-facts-model"]
    },
    {
      "term_id": "BT-014",
      "term": "Confidence Floor",
      "definition": "The minimum confidence score (currently 0.7) below which a proposed mapping always requires human approval, regardless of the REQUIRE_HUMAN_APPROVAL toggle. A safety net that prevents low-quality matches from being auto-promoted.",
      "source": "project-specific",
      "source_reference": "src/base/entity_resolution/config.py",
      "synonyms": ["Minimum Confidence Threshold"],
      "related_terms": ["BT-010", "BT-016"],
      "category": "pipeline",
      "owner": "Data Engineering",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-entity-resolution", "base-xbrl-tag-normalization"]
    },
    {
      "term_id": "BT-015",
      "term": "Tier",
      "definition": "A classification of match quality in tag normalization. Tier 1: exact concept name match (confidence 1.0). Tier 2: prefix or regex pattern match (confidence 0.6-0.7). Tier 3: unmapped, no CDE assignment (confidence 0.0). Tiers determine both the confidence score and the approval workflow.",
      "source": "project-specific",
      "source_reference": "docs/specs/base-xbrl-tag-normalization.md",
      "synonyms": ["Match Tier", "Classification Tier"],
      "related_terms": ["BT-011", "BT-010"],
      "category": "pipeline",
      "owner": "Data Engineering",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-xbrl-tag-normalization", "base-financial-facts-model"]
    },
    {
      "term_id": "BT-016",
      "term": "Human Approval Gate",
      "definition": "A point in the pipeline where processing pauses for human review before proceeding. Controlled globally by REQUIRE_HUMAN_APPROVAL in src/config.py. Used for entity resolution, tag normalization, data model progression, and business term approval.",
      "source": "project-specific",
      "source_reference": "src/config.py",
      "synonyms": ["Approval Gate", "Human-in-the-Loop Gate"],
      "related_terms": ["BT-014"],
      "category": "pipeline",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-entity-resolution", "base-xbrl-tag-normalization"]
    },
    {
      "term_id": "BT-017",
      "term": "Financial Fact",
      "definition": "A single reported financial value — one number, for one XBRL concept, in one unit, for one reporting period, from one SEC filing. The atomic unit of financial data in the pipeline. Grain: (CIK, concept, unit, start_date, end_date, accession_number).",
      "source": "project-specific",
      "source_reference": "docs/specs/base-financial-facts-model.md",
      "synonyms": ["Fact", "XBRL Fact", "Reported Value"],
      "related_terms": ["BT-009", "BT-004", "BT-018"],
      "category": "financial",
      "owner": "Finance",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-018",
      "term": "Fiscal Period",
      "definition": "A company's reporting period, identified by fiscal year and period type (FY = full year, Q1-Q4 = quarters). Each company has its own fiscal calendar — fiscal years may not align with calendar years (e.g., Apple's fiscal year ends September 30).",
      "source": "xbrl-taxonomy",
      "source_reference": "us-gaap Reporting Period documentation",
      "synonyms": ["Reporting Period", "Fiscal Quarter", "Fiscal Year"],
      "related_terms": ["BT-019", "BT-017"],
      "category": "financial",
      "owner": "Finance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": "CDE-005, CDE-006",
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-019",
      "term": "Fiscal Calendar",
      "definition": "A mapping of a company's fiscal periods to calendar dates. Built from observed filing data (actual start/end dates of reported periods), not from theoretical calculations. Handles edge cases where companies report outside expected windows.",
      "source": "project-specific",
      "source_reference": "docs/specs/base-financial-facts-model.md",
      "synonyms": ["Company Calendar", "Reporting Calendar"],
      "related_terms": ["BT-018"],
      "category": "pipeline",
      "owner": "Data Engineering",
      "status": "approved",
      "approved_by": "human:jeff",
      "approved_at": "2026-03-14T19:30:00Z",
      "cde_reference": null,
      "used_in_models": ["base-financial-facts-model"]
    },
    {
      "term_id": "BT-020",
      "term": "XBRL Taxonomy",
      "definition": "A structured classification system that defines financial reporting concepts and their relationships. The primary taxonomy is us-gaap (US Generally Accepted Accounting Principles). Others include dei (Document and Entity Information) and ifrs-full (International Financial Reporting Standards).",
      "source": "xbrl-taxonomy",
      "source_reference": "XBRL International Specification",
      "synonyms": ["Taxonomy", "Reporting Taxonomy"],
      "related_terms": ["BT-009"],
      "category": "financial",
      "owner": "Data Governance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": null,
      "used_in_models": ["base-xbrl-tag-normalization", "base-financial-facts-model"]
    },
    {
      "term_id": "BT-021",
      "term": "Financial Statement",
      "definition": "A category of financial reporting. The five categories used in this pipeline: Balance Sheet (assets, liabilities, equity), Income Statement (revenue, expenses, profit), Cash Flow (operating, investing, financing), Per-Share (EPS, dividends), and Other (comprehensive income, retained earnings).",
      "source": "xbrl-taxonomy",
      "source_reference": "us-gaap Financial Statement classification",
      "synonyms": ["Statement Type", "Report Type"],
      "related_terms": ["BT-009", "BT-013"],
      "category": "financial",
      "owner": "Finance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
      "approved_at": "2026-03-14T00:00:00Z",
      "cde_reference": null,
      "used_in_models": ["base-xbrl-tag-normalization", "base-financial-facts-model"]
    },
    {
      "term_id": "BT-022",
      "term": "Revenue",
      "definition": "Total revenue recognized from the sale of goods and services, before deductions. The top line of the income statement. Multiple XBRL concepts map to this CDE (Revenues, RevenueFromContractWithCustomerExcludingAssessedTax, SalesRevenueNet, etc.).",
      "source": "xbrl-taxonomy",
      "source_reference": "us-gaap:Revenues",
      "synonyms": ["Sales", "Net Sales", "Total Revenue", "Top Line"],
      "related_terms": ["BT-021", "BT-013"],
      "category": "financial",
      "owner": "Finance",
      "status": "approved",
      "approved_by": "auto (authoritative external standard)",
