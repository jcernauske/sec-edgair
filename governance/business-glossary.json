      "cde_reference": "CDE-015",
      "used_in_models": ["base-xbrl-tag-normalization", "base-financial-facts-model"]
    },
    {
      "term_id": "BT-023",
      "term": "Net Income",
      "definition": "Total profit after all expenses, interest, and taxes. The bottom line of the income statement.",
      "source": "xbrl-taxonomy",
      "source_reference": "us-gaap:NetIncomeLoss",
      "synonyms": ["Net Profit", "Net Earnings", "Bottom Line"],
      "related_terms": ["BT-022", "BT-021"],
      "category": "financial",
      "owner": "Finance",
